# ==============================================================================
# SolarPulse Environment Configuration
# Copy this file to .env and customize values to match your local setup.
# ==============================================================================

# Wi-Fi Data Logger Configuration (Eybond Wi-Fi Plug Pro / SmartESS)
# IP address of the Wi-Fi dongle on your local network
DONGLE_IP=192.168.0.100

# UDP port used by the dongle firmware for broadcast/redirect commands
DONGLE_UDP_PORT=58899

# (Optional) Dongle Product Number / Serial (14 to 18 characters)
DONGLE_PN=E50000000000000000

# (Optional) Inverter Serial Number (used for Home Assistant MQTT unique IDs)
INVERTER_SN=00000000000000

# Inverter Model Family Code (2451 = 0x0993 for Axpert / Voltronic PI30 protocol)
DEVCODE=2451

# RS-485 Inverter Address (standard is 1)
DEVADDR=1

# Local Server Configuration
# Leave HOST_IP blank to automatically detect the IP that routes to the dongle
HOST_IP=

# TCP port on your local machine that the dongle connects to
COLLECTOR_TCP_PORT=8899

# Web Dashboard HTTP Port
WEB_PORT=8500

# Polling interval in seconds (recommended: 1.5 to 3.0)
POLL_INTERVAL=2.0

# Database storage path (defaults to ./solar_history.db)
SOLAR_DB_PATH=solar_history.db

# Regional / Currency Customization
# Label for your local electrical grid (e.g. Utility Grid, WAPDA, Eskom, National Grid)
GRID_LABEL=Utility Grid

# Currency code (e.g. USD, EUR, PKR, GBP, ZAR, INR, AUD)
CURRENCY=USD

# Default electricity unit rate per kWh
TARIFF_RATE=0.20
